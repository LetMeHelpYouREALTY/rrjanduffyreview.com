# Public (exposed to the browser)
NEXT_PUBLIC_BASE_URL=https://www.drjanduffyreviews.com

# Must match this site's Google Business Profile business name exactly
NEXT_PUBLIC_GBP_BUSINESS_NAME=

# Primary NAP (defaults match Summerlin office if unset)
NEXT_PUBLIC_PRIMARY_PHONE=
NEXT_PUBLIC_PRIMARY_PHONE_TEL=
NEXT_PUBLIC_PRIMARY_STREET=
NEXT_PUBLIC_PRIMARY_CITY=
NEXT_PUBLIC_PRIMARY_ZIP=
NEXT_PUBLIC_CONTACT_EMAIL=

# GBP / Maps (optional upgrades)
NEXT_PUBLIC_GBP_PLACE_ID=
NEXT_PUBLIC_GBP_WRITEREVIEW_URL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Google Search Console (HTML tag verification → metadata)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# SEO / GEO (optional) — absolute URL or site-relative path to 1200×630 OG image
NEXT_PUBLIC_OG_IMAGE_URL=
# Comma- or space-separated profile URLs (LinkedIn, YouTube, etc.) for sameAs JSON-LD
NEXT_PUBLIC_SAME_AS=
# Set to true while GBP reviews tab should be hidden (e.g. verification window)
NEXT_PUBLIC_GBP_REVIEWS_DISABLED=false

# RealScout widget
NEXT_PUBLIC_REALSCOUT_AGENT_ENCODED_ID=

# Calendly — site-wide: floating badge + two inline embeds in layout (tour + consultation)
# Full event-type URLs from Calendly (e.g. 30-min tour, 15-min consult)
NEXT_PUBLIC_CALENDLY_TOUR_URL=
NEXT_PUBLIC_CALENDLY_CONSULTATION_URL=

# Server-only — Vercel AI Gateway + Parallel Search (POST /api/ai/parallel)
# Create key: Vercel dashboard → AI Gateway → API keys
AI_GATEWAY_API_KEY=
# Optional — gateway model id (default openai/gpt-4o-mini). See https://vercel.com/ai-gateway/models
AI_GATEWAY_MODEL=
# Optional — if set, clients must send header x-ai-chat-secret with this value
AI_CHAT_WEBHOOK_SECRET=
# Optional — Parallel tool maxResults 1–20 (default 8)
PARALLEL_SEARCH_MAX_RESULTS=
# Optional — one-shot (default) | agentic (token-efficient multi-step)
PARALLEL_SEARCH_MODE=
# Optional — comma-separated domains for sourcePolicy (if both are set, exclude list is used)
PARALLEL_SEARCH_EXCLUDE_DOMAINS=
PARALLEL_SEARCH_INCLUDE_DOMAINS=

# Optional — Parallel platform API key for higher MCP rate limits in Cursor (see https://docs.parallel.ai/integrations/mcp/search-mcp)
PARALLEL_API_KEY=

# Server-only — optional for static builds. If missing or invalid, AI summary uses a neutral on-page fallback (no failed deploy).
PERPLEXITY_API_KEY=
