{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "redirects": [
    {
      "source": "/\\$",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/%24",
      "destination": "/",
      "statusCode": 308
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "drjanduffyreviews.com"
        }
      ],
      "destination": "https://www.drjanduffyreviews.com/:path*",
      "statusCode": 308
    }
  ]
}
